--- !u!114 &8690996930266628059
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3123972946447844184}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3120fcb05d7fbb54395556669c9002c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EcosDelAzar.NPC.DialogueNPC
  interactAction: {fileID: 8038336070660516234, guid: d2b0bd47aafe82049b853d85d945ac0d, type: 3}
  exitAction: {fileID: 2144928836936293257, guid: d2b0bd47aafe82049b853d85d945ac0d, type: 3}
  lines:
  - text: Bienvenido al refugio, forastero...
    isReward: 0
  - text: "Aqu\xED las monedas son supervivencia. Con ellas compras ox\xEDgeno."
    isReward: 0
  - text: "G\xE1nalas en las mesas de juego de cada piso."
    isReward: 0
  - text: "Y un consejo: el director solo recibe a quien deja sin banca a tres crupieres. Cada mesa que vacíes te da una ficha de la casa."
    isReward: 0
  - text: "Con tres fichas, una de ellas de las plantas altas, el ascensor te abrirá la planta preferencial."
    isReward: 0
  - text: "Ah, y en el minibar de la planta 2 venden Ecos: recuerdos de jugadores que no salieron de aquí. Te hacen más fuerte, pero se pagan con monedas, con aire o con fichas. Elige bien."
    isReward: 0
  - text: "Toma, esto te ayudar\xE1 a empezar."
    isReward: 0
  - text: "Y si te quedas sin monedas, la máquina de la esquina te compra aire: un 10% del tanque son 15 monedas. Pruébala antes de subir."
    isReward: 0
  oneTimeOnly: 1
  persistenceId: concierge_lobby
  repeatLines:
  - text: "Ummm... ¿vuelves por aquí? No tengo más dinero para ti."
    isReward: 0
