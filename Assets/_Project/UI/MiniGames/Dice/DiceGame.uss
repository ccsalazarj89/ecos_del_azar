.dice-board {
    position: absolute;
    top: 22%;
    left: 50%;
    translate: -50% -50%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 600px;
    height: 300px;
}

.dice-container {
    flex-direction: column;
    align-items: center;
    margin: 0 40px;
}

.dice-label {
    font-size: 24px;
    color: rgb(220, 200, 180);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-shadow: 0 5px 10px rgba(0, 0, 0, 0.8);
}

.dice-bg {
    width: 140px;
    height: 140px;
    background-color: rgba(15, 10, 5, 0.8);
    border-radius: 12px;
    border-width: 4px;
    border-color: rgb(80, 60, 40);
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
}

.dice-img {
    width: 100px;
    height: 100px;
    transition-property: scale, rotate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
