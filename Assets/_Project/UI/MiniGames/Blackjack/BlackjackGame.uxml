<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BlackjackGame.uss" />

    <ui:VisualElement name="bj-board" class="bj-board" picking-mode="Ignore">
        <ui:VisualElement class="bj-side">
            <ui:VisualElement class="bj-header">
                <ui:Label text="RIVAL" class="bj-label" />
                <ui:Label name="opponent-score" text="0" class="bj-score" />
            </ui:VisualElement>
            <ui:VisualElement name="opponent-hand-row" class="bj-hand-row" />
        </ui:VisualElement>

        <ui:VisualElement class="bj-side">
            <ui:VisualElement class="bj-header">
                <ui:Label text="TÚ" class="bj-label" />
                <ui:Label name="player-score" text="0" class="bj-score" />
            </ui:VisualElement>
            <ui:VisualElement name="player-hand-row" class="bj-hand-row" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="bj-action-panel" class="bj-action-panel" picking-mode="Position">
        <ui:Button name="btn-hit" text="PEDIR" class="bj-action-btn" />
        <ui:Button name="btn-stand" text="PLANTARSE" class="bj-action-btn" />
    </ui:VisualElement>
</ui:UXML>
