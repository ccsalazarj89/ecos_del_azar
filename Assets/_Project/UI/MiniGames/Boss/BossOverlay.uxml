<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BossOverlay.uss" />

    <!-- Boss suit card: sits under the HUD oxygen module, non-interactive -->
    <ui:VisualElement name="boss-suit-badge" class="boss-suit-badge" picking-mode="Ignore">
        <ui:VisualElement class="boss-suit-header">
            <ui:Label name="boss-suit-icon" text="?" class="boss-suit-icon" />
            <ui:VisualElement class="boss-suit-titles">
                <ui:Label text="PALO DEL DIRECTOR" class="boss-suit-title" />
                <ui:Label name="boss-suit-name" text="" class="boss-suit-name" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="boss-suit-rule" text="" class="boss-suit-rule" />
    </ui:VisualElement>

    <!-- Short toast (sudden-death declined, etc.) -->
    <ui:VisualElement name="boss-toast" class="boss-toast" style="display: none;" picking-mode="Ignore">
        <ui:Label name="toast-title" text="" class="boss-toast-label" />
        <ui:Label name="toast-sub" text="" class="boss-toast-sub" />
    </ui:VisualElement>

    <!-- Panel: propuesta de muerte súbita -->
    <ui:VisualElement name="sudden-death-proposal" class="sd-overlay" style="display: none;">
        <ui:Label text="¡ MUERTE SÚBITA !" class="sd-title" />
        <ui:Label text="El boss propone apostarlo todo en una sola ronda" class="sd-subtitle" />
        <ui:Label name="sd-pot-label" text="" class="sd-pot" />
        <ui:VisualElement class="sd-proposal-buttons">
            <ui:Button name="btn-accept-sd" text="ACEPTAR" class="sd-btn sd-btn--accept" />
            <ui:Button name="btn-decline-sd" text="RECHAZAR" class="sd-btn sd-btn--decline" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Panel: 7 face-down cards (6 safe + joker) -->
    <ui:VisualElement name="sudden-death-cards" class="sd-overlay" style="display: none;">
        <ui:Label name="sd-turn-label" text="TU TURNO — Elige una carta" class="sd-turn-label" />
        <ui:VisualElement name="cards-row" class="cards-row">
            <ui:Button name="card-0" text="?" class="sd-card" />
            <ui:Button name="card-1" text="?" class="sd-card" />
            <ui:Button name="card-2" text="?" class="sd-card" />
            <ui:Button name="card-3" text="?" class="sd-card" />
            <ui:Button name="card-4" text="?" class="sd-card" />
            <ui:Button name="card-5" text="?" class="sd-card" />
            <ui:Button name="card-6" text="?" class="sd-card" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Panel: resultado de la muerte súbita -->
    <ui:VisualElement name="sudden-death-result" class="sd-overlay" style="display: none;">
        <ui:Label name="sd-result-label" text="" class="sd-result-label" />
        <ui:Label name="sd-result-sub" text="" class="sd-result-sub" />
    </ui:VisualElement>

</ui:UXML>
