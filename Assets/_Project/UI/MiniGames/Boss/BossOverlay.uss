/* ═══════════════════════════════════════════════
   BOSS OVERLAY — suit badge, toast, sudden death
   ═══════════════════════════════════════════════ */

/* ── Boss suit badge: sits between the board and the betting panel ── */

/* Docked under the HUD oxygen module (top-left), same width, out of the play area. */
.boss-suit-badge {
    position: absolute;
    top: 152px;
    left: 30px;
    width: 260px;
    flex-direction: column;
    padding: 8px 14px 10px 14px;
    background-color: rgba(14, 10, 8, 0.9);
    border-width: 1px;
    border-color: rgba(220, 60, 50, 0.4);
    border-left-width: 4px;
    border-left-color: rgb(220, 60, 50);
}

.boss-suit-header {
    flex-direction: row;
    align-items: center;
}

.boss-suit-icon {
    font-size: 26px;
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    color: rgb(220, 60, 50);
    text-shadow: 0 0 10px rgba(220, 60, 50, 0.6);
    margin-right: 10px;
    min-width: 26px;
    -unity-text-align: middle-center;
}

.boss-suit-titles {
    flex-direction: column;
    justify-content: center;
}

/* Labels carry a default margin in the runtime theme; zero it so the title and
   the suit name read as one block instead of two separated lines. */
.boss-suit-title {
    font-size: 9px;
    color: rgba(200, 150, 130, 0.7);
    letter-spacing: 3px;
    margin: 0;
    padding: 0;
}

.boss-suit-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 200, 190);
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
}

.boss-suit-rule {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: rgba(220, 190, 180, 0.75);
    white-space: normal;
}

/* ── Toast ── */

.boss-toast {
    position: absolute;
    top: 80px;
    left: 50%;
    translate: -50% 0;
    background-color: rgba(60, 20, 18, 0.95);
    border-width: 2px;
    border-color: rgb(220, 60, 50);
    border-radius: 4px;
    padding: 10px 22px;
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.boss-toast--hidden {
    opacity: 0;
}

.boss-toast-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 200, 180);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.boss-toast-sub {
    font-size: 12px;
    color: rgba(255, 220, 200, 0.8);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ── Overlay compartido (propuesta, cartas, resultado) ── */

.sd-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: rgba(8, 5, 4, 0.97);
    border-radius: 5px;
    border-width: 2px;
    border-color: rgb(160, 40, 40);
    border-top-width: 5px;
    border-top-color: rgb(220, 50, 40);
    padding: 32px 40px;
    align-items: center;
    min-width: 500px;
}

/* ── Panel Propuesta ── */

.sd-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(220, 60, 50);
    text-shadow: 0 0 18px rgba(220, 50, 40, 0.7);
    margin-bottom: 10px;
}

.sd-subtitle {
    font-size: 15px;
    color: rgb(200, 180, 160);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    letter-spacing: 1px;
}

.sd-pot {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 220, 80);
    text-shadow: 0 0 8px rgba(255, 200, 0, 0.4);
    margin-bottom: 24px;
}

.sd-proposal-buttons {
    flex-direction: row;
    justify-content: center;
}

.sd-btn {
    height: 52px;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 3px;
    border-width: 2px;
    margin: 0 8px;
    padding: 0 28px;
    color: white;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.sd-btn:hover { scale: 1.07; }
.sd-btn:active { scale: 0.94; }

.sd-btn--accept {
    background-color: rgb(30, 110, 45);
    border-color: rgb(50, 170, 65);
}

.sd-btn--accept:hover {
    background-color: rgb(40, 140, 55);
}

.sd-btn--decline {
    background-color: rgb(90, 35, 35);
    border-color: rgb(150, 50, 50);
}

.sd-btn--decline:hover {
    background-color: rgb(120, 45, 40);
}

/* ── Panel Cartas ── */

.sd-turn-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 200, 160);
    letter-spacing: 2px;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.cards-row {
    flex-direction: row;
    justify-content: center;
}

.sd-card {
    width: 70px;
    height: 100px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 220, 80);
    background-color: rgba(30, 20, 15, 0.9);
    border-width: 2px;
    border-color: rgb(120, 85, 40);
    border-radius: 6px;
    margin: 0 6px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.14s;
}

.sd-card:hover {
    scale: 1.1;
    background-color: rgba(60, 40, 20, 0.95);
    border-color: rgb(200, 150, 50);
}

.sd-card:active {
    scale: 0.96;
}

.sd-card--revealed {
    color: rgb(180, 160, 140);
    background-color: rgba(15, 10, 8, 0.8);
    border-color: rgba(100, 70, 40, 0.4);
}

.sd-card--joker {
    color: rgb(220, 60, 50);
    border-color: rgb(200, 50, 40);
    text-shadow: 0 0 10px rgba(220, 50, 40, 0.7);
}

.sd-card--winner {
    border-color: rgb(80, 200, 80);
    text-shadow: 0 0 10px rgba(80, 200, 80, 0.6);
}

/* ── Panel Resultado ── */

.sd-result-label {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.sd-result-label--win {
    color: rgb(80, 220, 80);
    text-shadow: 0 0 20px rgba(80, 220, 80, 0.6);
}

.sd-result-label--lose {
    color: rgb(220, 60, 50);
    text-shadow: 0 0 20px rgba(220, 50, 40, 0.6);
}

.sd-result-sub {
    font-size: 18px;
    color: rgb(200, 180, 150);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}
