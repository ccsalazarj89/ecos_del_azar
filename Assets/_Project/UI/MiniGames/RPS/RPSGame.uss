.rps-board {
    position: absolute;
    top: 22%;
    left: 50%;
    translate: -50% -50%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 640px;
    height: 300px;
}

.rps-hand-container {
    flex-direction: column;
    align-items: center;
    margin: 0 40px;
}

.rps-label {
    font-size: 24px;
    color: rgb(220, 200, 180);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-shadow: 0 5px 10px rgba(0, 0, 0, 0.8);
}

.rps-hand-bg {
    width: 160px;
    height: 160px;
    background-color: rgba(15, 10, 5, 0.8);
    border-radius: 12px;
    border-width: 4px;
    border-color: rgb(80, 60, 40);
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
}

.rps-hand-img {
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.rps-vs {
    font-size: 28px;
    color: rgba(220, 200, 180, 0.5);
    -unity-font-style: bold;
    margin-top: 40px;
    margin-right: 6px;
    margin-left: 6px;
}

.rps-choice-panel {
    position: absolute;
    bottom: 18%;
    left: 50%;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
    padding: 20px 30px;
    background-color: rgba(15, 10, 5, 0.85);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(120, 90, 50);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
}

.rps-choice-title {
    font-size: 20px;
    color: rgb(220, 200, 180);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 14px;
}

.rps-choice-row {
    flex-direction: row;
    justify-content: center;
}

.rps-choice-btn {
    width: 140px;
    height: 60px;
    margin: 0 8px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(240, 220, 180);
    background-color: rgb(60, 40, 25);
    border-width: 2px;
    border-color: rgb(140, 100, 60);
    border-radius: 8px;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.rps-choice-btn:hover {
    background-color: rgb(90, 60, 35);
    scale: 1.05 1.05;
}

.rps-choice-btn:active {
    background-color: rgb(140, 100, 60);
    scale: 0.97 0.97;
}
