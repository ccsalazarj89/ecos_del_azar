/* Board lives in the top zone (4%-42%); the choice panel in the middle zone
   (44%-62%); the betting panel owns the bottom. See BettingPanel.uss. */

.rps-board {
    position: absolute;
    top: 5%;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 640px;
}

.rps-hand-container {
    flex-direction: column;
    align-items: center;
    margin: 0 40px;
}

.rps-label {
    font-size: 22px;
    color: rgb(220, 200, 180);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 12px;
    text-shadow: 0 5px 10px rgba(0, 0, 0, 0.8);
}

.rps-hand-bg {
    width: 150px;
    height: 150px;
    background-color: rgba(15, 10, 5, 0.8);
    border-radius: 12px;
    border-width: 4px;
    border-color: rgb(80, 60, 40);
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
}

.rps-hand-img {
    position: absolute;
    width: 110px;
    height: 110px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Text fallback shown while no hand sprites are assigned. */
.rps-hand-text {
    font-size: 22px;
    color: rgb(240, 220, 180);
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.rps-vs {
    font-size: 28px;
    color: rgba(220, 200, 180, 0.5);
    -unity-font-style: bold;
    margin-top: 34px;
    margin-right: 6px;
    margin-left: 6px;
}

.rps-choice-panel {
    position: absolute;
    top: 45%;
    left: 50%;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
    padding: 14px 24px;
    background-color: rgba(15, 10, 5, 0.85);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(120, 90, 50);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
}

.rps-choice-title {
    font-size: 18px;
    color: rgb(220, 200, 180);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.rps-choice-row {
    flex-direction: row;
    justify-content: center;
}

.rps-choice-btn {
    width: 130px;
    height: 52px;
    margin: 0 8px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(240, 220, 180);
    background-color: rgb(60, 40, 25);
    border-width: 2px;
    border-color: rgb(140, 100, 60);
    border-radius: 8px;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.rps-choice-btn:hover {
    background-color: rgb(90, 60, 35);
    scale: 1.05 1.05;
}

.rps-choice-btn:active {
    background-color: rgb(140, 100, 60);
    scale: 0.97 0.97;
}
