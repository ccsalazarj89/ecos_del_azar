.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.7);
}

.overlay__box {
    width: 380px;
    background-color: rgba(20, 20, 30, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.4);
    padding: 24px;
    align-items: center;
}

.overlay__title {
    font-size: 22px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.cards-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.card-slot {
    align-items: center;
    min-width: 100px;
}

.card-slot__label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 6px;
}

.card-slot__value {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.08);
    padding: 8px 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.vs-label {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 16px;
}

.result-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0);
    margin-bottom: 16px;
}

.continue-btn {
    width: 140px;
    height: 38px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(40, 100, 160);
    border-color: rgb(60, 140, 200);
    border-width: 2px;
    border-radius: 6px;
    color: rgb(255, 255, 255);
}

.continue-btn:hover {
    background-color: rgb(50, 120, 190);
}
