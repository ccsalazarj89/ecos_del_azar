<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="DuelOverlay.uss" />

    <ui:VisualElement name="duel-overlay" class="overlay">
        <ui:VisualElement class="overlay__box">
            <ui:Label text="Duelo" class="overlay__title" />

            <ui:VisualElement class="cards-row">
                <ui:VisualElement class="card-slot">
                    <ui:Label text="Tu carta" class="card-slot__label" />
                    <ui:Label name="player-card" text="--" class="card-slot__value" />
                </ui:VisualElement>

                <ui:Label text="VS" class="vs-label" />

                <ui:VisualElement class="card-slot">
                    <ui:Label text="Oponente" class="card-slot__label" />
                    <ui:Label name="opponent-card" text="--" class="card-slot__value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="result-text" text="" class="result-text" />
            <ui:Button name="btn-continue" text="Continuar" class="continue-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
