.card-board {
    position: absolute;
    top: 6%;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 600px;
}

.card-container {
    flex-direction: column;
    align-items: center;
    margin: 0 30px;
}

.card-label {
    font-size: 24px;
    color: rgb(220, 200, 180);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-shadow: 0 5px 10px rgba(0, 0, 0, 0.8);
}

.card-img {
    width: 130px;
    height: 182px;
    background-color: rgba(15, 10, 5, 0.8);
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(80, 60, 40);
    -unity-background-scale-mode: scale-to-fit;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
    transition-property: scale, rotate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.vs-label {
    font-size: 28px;
    color: rgba(220, 200, 180, 0.5);
    -unity-font-style: bold;
    margin-top: 40px;
    margin-right: 6px;
    margin-left: 6px;
}
