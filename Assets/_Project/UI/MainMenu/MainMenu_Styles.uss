.menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.menu-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 7, 6);
}

.menu-panel {
    background-color: rgba(12, 10, 8, 0.92);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(180, 120, 40, 0.3);
    padding: 48px 64px;
    align-items: center;
    width: 520px;
}

.menu-title {
    color: rgb(255, 200, 0);
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 16px rgba(255, 185, 0, 0.5);
    margin-bottom: 8px;
}

.menu-subtitle {
    color: rgba(200, 180, 150, 0.6);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.menu-options {
    width: 100%;
}

.menu-button {
    background-color: rgba(20, 18, 15, 0.9);
    border-width: 2px;
    border-left-width: 4px;
    border-color: rgba(180, 120, 40, 0.3);
    border-left-color: rgb(0, 180, 220);
    border-radius: 3px;
    color: rgb(220, 210, 195);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    padding: 16px 0;
    margin: 0 0 16px 0;
    transition-property: border-color, scale, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    border-color: rgba(180, 120, 40, 0.6);
    scale: 1.02;
}

.menu-button--primary {
    border-left-color: rgb(255, 185, 0);
    color: rgb(255, 230, 150);
}

.menu-button--primary:hover {
    background-color: rgba(40, 30, 10, 0.9);
}

.menu-button--danger {
    border-left-color: rgb(220, 60, 50);
    color: rgb(255, 120, 100);
}

.menu-button--danger:hover {
    background-color: rgba(60, 15, 10, 0.9);
}
