<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/MainMenu/MainMenu_Styles.uss"/>
    <ui:VisualElement name="menu-root" class="menu-root">
        <ui:VisualElement name="menu-backdrop" class="menu-backdrop" picking-mode="Ignore"/>
        <ui:VisualElement name="menu-panel" class="menu-panel">
            <ui:Label text="ECOS DEL AZAR" class="menu-title"/>
            <ui:Label text="Sube. Apuesta. Sobrevive." class="menu-subtitle"/>
            <ui:VisualElement name="menu-options" class="menu-options">
                <ui:Button name="PlayButton" text="JUGAR" class="menu-button menu-button--primary"/>
                <ui:Button name="QuitButton" text="SALIR" class="menu-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
