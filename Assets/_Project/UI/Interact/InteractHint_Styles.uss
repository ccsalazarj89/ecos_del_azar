.interact-hint-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-start;
    align-items: center;
    padding-bottom: 5%;
    flex-basis: 100%;
    flex-grow: 1;
    flex-direction: column-reverse;
    flex-wrap: wrap;
    align-content: auto;
    padding-top: 5%;
    padding-right: 5%;
    padding-left: 5%;
    align-self: auto;
}

.interact-hint--hidden {
    display: none;
}

.interact-hint-box {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 8, 6, 0.9);
    padding: 12px 22px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 200, 240, 0.4);
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    bottom: -13%;
    top: auto;
    padding-top: 25px;
    padding-right: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
    -unity-text-align: middle-center;
    align-content: auto;
    justify-content: flex-start;
}

.interact-hint-key {
    width: 38px;
    height: 38px;
    background-color: rgba(0, 200, 240, 0.12);
    border-width: 2px;
    border-color: rgb(0, 200, 240);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    margin-right: 14px;
}

.interact-hint-key-label {
    color: rgb(0, 220, 255);
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 0 0 8px rgba(0, 220, 255, 0.6);
}

.interact-hint-text {
    color: rgb(200, 190, 170);
    font-size: 16px;
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: 0.2s;
}

.interact-hint--warning .interact-hint-box {
    border-color: rgba(220, 60, 40, 0.6);
}

.interact-hint--warning .interact-hint-key {
    border-color: rgb(220, 60, 40);
    background-color: rgba(220, 60, 40, 0.12);
}

.interact-hint--warning .interact-hint-key-label {
    color: rgb(220, 80, 60);
    text-shadow: 0 0 8px rgba(220, 60, 40, 0.6);
}

.interact-hint--warning .interact-hint-text {
    color: rgb(220, 80, 60);
}

.interact-hint-hidden {
}
