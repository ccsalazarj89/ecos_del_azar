
.hud-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

/* ── TOP BAR POSITIONING ── */

.hud-top-left {
    position: absolute;
    top: 24px;
    left: 30px;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.hud-top-right {
    position: absolute;
    top: 24px;
    right: 30px;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

/* ── MODULE BASE — Scratched metal panel ── */

.hud-module {
    background-color: rgba(12, 10, 8, 0.92);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(180, 120, 40, 0.3);
    padding: 14px 22px;
    flex-direction: row;
    align-items: center;
    transition-property: border-color, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.hud-module:hover {
    border-color: rgba(180, 120, 40, 0.6);
    scale: 1.02;
}

/* ── COINS MODULE — Flickering gold neon ── */

.coins-module {
    border-left-width: 4px;
    border-left-color: rgb(255, 185, 0);
    height: 64px;
    padding: 10px 20px;
    transition-property: border-left-color, background-color;
    transition-duration: 0.5s;
}

.coin-icon {
    width: 32px;
    height: 32px;
    background-color: rgb(255, 200, 0);
    border-radius: 16px;
    margin-right: 14px;
    border-width: 2px;
    border-color: rgb(200, 140, 0);
    transition-property: scale, rotate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.coins-module:hover .coin-icon {
    scale: 1.15;
    rotate: 15deg;
}

.coins-value {
    color: rgb(255, 230, 150);
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    text-shadow: 0 0 8px rgba(255, 185, 0, 0.5);
    transition-property: color, scale;
    transition-duration: 0.2s;
}

.coins-value:hover {
    color: rgb(255, 245, 200);
    text-shadow: 0 0 14px rgba(255, 200, 0, 0.8);
}

/* ── OXYGEN MODULE — Toxic cyan glow ── */

.oxygen-module {
    border-left-width: 4px;
    border-left-color: rgb(0, 180, 220);
    flex-direction: column;
    align-items: flex-start;
    width: 260px;
    padding: 10px 18px;
    transition-property: border-left-color;
    transition-duration: 0.4s;
}

.oxygen-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    width: 100%;
}

.oxygen-icon {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(0, 180, 220);
    margin-right: 8px;
    transition-property: scale, background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.oxygen-label {
    color: rgb(0, 200, 240);
    font-size: 12px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    text-shadow: 0 0 6px rgba(0, 200, 240, 0.4);
    transition-property: color;
    transition-duration: 0.3s;
}

.oxygen-percent {
    color: rgb(0, 200, 240);
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: auto;
    text-shadow: 0 0 4px rgba(0, 200, 240, 0.3);
}

.oxygen-bar-bg {
    width: 100%;
    height: 14px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 2px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(0, 180, 220, 0.25);
}

.oxygen-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 160, 200);
    border-radius: 2px;
    transition-property: width, background-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

/* Oxygen states */
.oxygen-bar-fill.oxygen-low {
    background-color: rgb(230, 120, 30);
}

.oxygen-bar-fill.oxygen-critical {
    background-color: rgb(255, 40, 40);
}

.oxygen-module.oxygen-critical-state {
    border-left-color: rgb(255, 40, 40);
}

.oxygen-module.oxygen-critical-state .oxygen-label {
    color: rgb(255, 60, 60);
    text-shadow: 0 0 8px rgba(255, 40, 40, 0.7);
}

.oxygen-module.oxygen-critical-state .oxygen-icon {
    background-color: rgb(255, 40, 40);
    scale: 1.2;
}

/* ── BOTTOM HINTS — Wasteland radio static ── */

.hud-bottom-center {
    position: absolute;
    bottom: 30px;
    left: 50%;
    translate: -50% 0;
}

.hint-label {
    color: rgba(200, 180, 150, 0.6);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: opacity, color;
    transition-duration: 0.5s;
}

.hint-label:hover {
    color: rgba(255, 210, 100, 0.9);
}

/* ── HOUSE CHIPS — the key to the boss floor ── */

.chips-module {
    margin-top: 8px;
    flex-direction: column;
    align-items: flex-end;
    padding: 8px 14px;
}

.chips-label {
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(200, 180, 150, 0.5);
    margin-bottom: 6px;
}

.chips-row {
    flex-direction: row;
}

.chip-slot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-left: 6px;
    border-width: 2px;
    border-color: rgba(255, 200, 50, 0.25);
    background-color: rgba(0, 0, 0, 0.4);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.4s;
}

.chip-slot--earned {
    background-color: rgb(255, 200, 50);
    border-color: rgb(255, 240, 180);
    scale: 1.1;
}

/* ── ANNOUNCEMENT — casino PA system, full-screen interruption ── */

.announcement {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.78);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.35s;
    opacity: 1;
}

.announcement--hidden {
    opacity: 0;
    display: none;
}

.announcement__panel {
    width: 640px;
    padding: 26px 32px;
    align-items: center;
    background-color: rgba(14, 10, 8, 0.96);
    border-width: 1px;
    border-color: rgba(255, 200, 50, 0.35);
    border-left-width: 5px;
    border-left-color: rgb(255, 185, 0);
}

.announcement__tag {
    font-size: 11px;
    letter-spacing: 5px;
    color: rgb(255, 185, 0);
    margin-bottom: 12px;
}

.announcement__text {
    font-size: 20px;
    color: rgb(230, 220, 200);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.announcement__hint {
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(200, 180, 150, 0.45);
}

/* ── RUN END — death / victory overlay ── */

.run-end {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.5s;
    opacity: 1;
}

.run-end--hidden {
    opacity: 0;
    display: none;
}

.run-end__panel {
    width: 620px;
    padding: 36px 40px;
    align-items: center;
    background-color: rgba(14, 10, 8, 0.96);
    border-width: 2px;
    border-color: rgb(120, 85, 40);
    border-top-width: 4px;
    border-top-color: rgb(200, 60, 50);
}

.run-end__title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(255, 230, 150);
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.run-end__subtitle {
    font-size: 15px;
    color: rgb(190, 175, 150);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 26px;
}

.run-end__button {
    width: 260px;
    height: 50px;
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(140, 40, 40);
    border-width: 2px;
    border-color: rgb(200, 60, 50);
    border-radius: 3px;
}

.run-end__button:hover {
    background-color: rgb(180, 50, 50);
}

/* ── OBJECTIVE — tutorial banner, top centre between the HUD corners ── */

.objective {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 18px 8px 10px;
    background-color: rgba(14, 10, 8, 0.9);
    border-width: 1px;
    border-color: rgba(255, 200, 50, 0.4);
    border-left-width: 5px;
    border-left-color: rgb(255, 185, 0);
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    opacity: 1;
}

.objective--hidden {
    opacity: 0;
    translate: -50% -12px;
    display: none;
}

.objective__badge {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(255, 200, 50, 0.12);
    border-width: 2px;
    border-color: rgb(255, 185, 0);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
}

.objective__step {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 220, 120);
}

.objective__icon {
    font-size: 22px;
    color: rgb(255, 200, 50);
    margin-right: 12px;
    -unity-text-align: middle-center;
    min-width: 30px;
    text-shadow: 0 0 10px rgba(255, 200, 0, 0.5);
}

.objective__body {
    flex-direction: column;
}

.objective__tag {
    font-size: 9px;
    letter-spacing: 4px;
    color: rgba(255, 200, 50, 0.7);
    margin-bottom: 2px;
}

.objective__text {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 225, 190);
}

/* ── ECHOES — active passive upgrades, under the chips ── */

.echoes-module {
    margin-top: 8px;
    flex-direction: column;
    align-items: flex-end;
    padding: 8px 14px;
}

.echoes-module--hidden {
    display: none;
}

.echo-badges {
    flex-direction: row;
}

.echo-badge {
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    margin-left: 6px;
    border-radius: 4px;
    background-color: rgba(120, 60, 200, 0.18);
    border-width: 1px;
    border-color: rgb(180, 120, 255);
    color: rgb(220, 190, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}


/* ── PAUSE ── */

.pause {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
}

.pause--hidden {
    display: none;
}

.pause__panel {
    width: 420px;
    padding: 30px 36px;
    align-items: center;
    background-color: rgba(14, 10, 8, 0.97);
    border-width: 2px;
    border-color: rgb(120, 85, 40);
    border-top-width: 4px;
    border-top-color: rgb(200, 140, 40);
}

.pause__title {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(255, 230, 150);
    margin-bottom: 6px;
}

.pause__subtitle {
    font-size: 13px;
    color: rgba(200, 180, 150, 0.6);
    margin-bottom: 22px;
}

.pause__button {
    width: 300px;
    height: 46px;
    margin-bottom: 10px;
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(220, 210, 195);
    background-color: rgba(20, 18, 15, 0.9);
    border-width: 2px;
    border-left-width: 4px;
    border-color: rgba(180, 120, 40, 0.3);
    border-left-color: rgb(0, 180, 220);
    border-radius: 3px;
}

.pause__button:hover {
    border-color: rgba(180, 120, 40, 0.6);
    scale: 1.02;
}

.pause__button--primary {
    border-left-color: rgb(255, 185, 0);
    color: rgb(255, 230, 150);
}

.pause__button--danger {
    border-left-color: rgb(220, 60, 50);
}

.pause__hint {
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(200, 180, 150, 0.45);
}

/* ── CREDITS ── */

.credits {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.92);
    justify-content: center;
    align-items: center;
}

.credits--hidden {
    display: none;
}

.credits__panel {
    width: 820px;
    padding: 34px 40px;
    align-items: center;
    background-color: rgba(14, 10, 8, 0.97);
    border-width: 2px;
    border-color: rgb(120, 85, 40);
    border-top-width: 4px;
    border-top-color: rgb(255, 185, 0);
}

.credits__title {
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(255, 230, 150);
    text-shadow: 0 0 16px rgba(255, 200, 0, 0.35);
}

.credits__subtitle {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(200, 180, 150, 0.6);
    margin-top: 4px;
    margin-bottom: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.credits__columns {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.credits__column {
    width: 48%;
}

.credits__heading {
    font-size: 11px;
    letter-spacing: 4px;
    color: rgb(255, 185, 0);
    margin-top: 10px;
    margin-bottom: 8px;
}

.credits__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 225, 190);
    margin-top: 6px;
}

.credits__role {
    font-size: 12px;
    color: rgba(200, 180, 150, 0.7);
    white-space: normal;
}

.credits__outro {
    margin-top: 26px;
    margin-bottom: 18px;
    font-size: 13px;
    color: rgb(0, 200, 240);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.credits__button {
    width: 220px;
    height: 46px;
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(30, 120, 50);
    border-width: 2px;
    border-color: rgb(50, 180, 70);
    border-radius: 3px;
}

.credits__button:hover {
    background-color: rgb(40, 150, 60);
}
