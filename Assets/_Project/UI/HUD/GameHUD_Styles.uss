
.hud-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ── TOP BAR POSITIONING ── */

.hud-top-left {
    position: absolute;
    top: 24px;
    left: 30px;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.hud-top-right {
    position: absolute;
    top: 24px;
    right: 30px;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

/* ── MODULE BASE — Scratched metal panel ── */

.hud-module {
    background-color: rgba(12, 10, 8, 0.92);
    border-radius: 3px;
    border-width: 2px;
    border-color: rgba(180, 120, 40, 0.3);
    padding: 14px 22px;
    flex-direction: row;
    align-items: center;
    transition-property: border-color, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.hud-module:hover {
    border-color: rgba(180, 120, 40, 0.6);
    scale: 1.02;
}

/* ── COINS MODULE — Flickering gold neon ── */

.coins-module {
    border-left-width: 4px;
    border-left-color: rgb(255, 185, 0);
    height: 64px;
    padding: 10px 20px;
    transition-property: border-left-color, background-color;
    transition-duration: 0.5s;
}

.coin-icon {
    width: 32px;
    height: 32px;
    background-color: rgb(255, 200, 0);
    border-radius: 16px;
    margin-right: 14px;
    border-width: 2px;
    border-color: rgb(200, 140, 0);
    transition-property: scale, rotate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.coins-module:hover .coin-icon {
    scale: 1.15;
    rotate: 15deg;
}

.coins-value {
    color: rgb(255, 230, 150);
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    text-shadow: 0 0 8px rgba(255, 185, 0, 0.5);
    transition-property: color, scale;
    transition-duration: 0.2s;
}

.coins-value:hover {
    color: rgb(255, 245, 200);
    text-shadow: 0 0 14px rgba(255, 200, 0, 0.8);
}

/* ── OXYGEN MODULE — Toxic cyan glow ── */

.oxygen-module {
    border-left-width: 4px;
    border-left-color: rgb(0, 180, 220);
    flex-direction: column;
    align-items: flex-start;
    width: 260px;
    padding: 10px 18px;
    transition-property: border-left-color;
    transition-duration: 0.4s;
}

.oxygen-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    width: 100%;
}

.oxygen-icon {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(0, 180, 220);
    margin-right: 8px;
    transition-property: scale, background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.oxygen-label {
    color: rgb(0, 200, 240);
    font-size: 12px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    text-shadow: 0 0 6px rgba(0, 200, 240, 0.4);
    transition-property: color;
    transition-duration: 0.3s;
}

.oxygen-percent {
    color: rgb(0, 200, 240);
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: auto;
    text-shadow: 0 0 4px rgba(0, 200, 240, 0.3);
}

.oxygen-bar-bg {
    width: 100%;
    height: 14px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 2px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(0, 180, 220, 0.25);
}

.oxygen-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 160, 200);
    border-radius: 2px;
    transition-property: width, background-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

/* Oxygen states via USS classes toggled from code */
.oxygen-bar-fill.oxygen-low {
    background-color: rgb(220, 60, 30);
}

.oxygen-bar-fill.oxygen-critical {
    background-color: rgb(255, 30, 30);
}

.oxygen-module.oxygen-critical-state {
    border-left-color: rgb(255, 40, 40);
}

.oxygen-module.oxygen-critical-state .oxygen-label {
    color: rgb(255, 60, 60);
    text-shadow: 0 0 8px rgba(255, 40, 40, 0.7);
}

.oxygen-module.oxygen-critical-state .oxygen-icon {
    background-color: rgb(255, 40, 40);
    scale: 1.2;
}

/* ── BOTTOM HINTS — Wasteland radio static ── */

.hud-bottom-center {
    position: absolute;
    bottom: 30px;
    left: 50%;
    translate: -50% 0;
}

.hint-label {
    color: rgba(200, 180, 150, 0.6);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: opacity, color;
    transition-duration: 0.5s;
}

.hint-label:hover {
    color: rgba(255, 210, 100, 0.9);
}
