.elevator-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.elevator-hidden {
    display: none;
}

.elevator-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 3, 2, 0.92);
    transition-property: opacity;
    transition-duration: 0.3s;
}

/* ── MAIN PANEL — Scratched industrial metal ── */

.elevator-panel {
    width: 720px;
    min-height: 640px;
    padding: 0;
    background-color: rgb(22, 18, 14);
    border-radius: 2px;
    border-width: 3px;
    border-color: rgb(90, 65, 35);
    border-top-width: 6px;
    border-top-color: rgb(200, 140, 40);
    flex-direction: column;
    overflow: hidden;
    transition-property: scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.elevator-panel:hover {
    border-color: rgb(120, 85, 45);
}

/* ── HEADER — Neon sign above the lift ── */

.elevator-header {
    align-items: center;
    padding: 20px 30px;
    background-color: rgba(0, 0, 0, 0.5);
    border-bottom-width: 3px;
    border-bottom-color: rgb(180, 50, 50);
    flex-direction: row;
    justify-content: space-between;
}

.elevator-title {
    color: rgb(255, 200, 80);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 14px rgba(255, 200, 80, 0.6), 0 2px 4px rgba(0, 0, 0, 0.8);
    transition-property: color, text-shadow;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.elevator-title:hover {
    color: rgb(255, 220, 120);
    text-shadow: 0 0 20px rgba(255, 220, 120, 0.8), 0 0 40px rgba(255, 180, 50, 0.3);
}

.elevator-subtitle {
    color: rgb(120, 100, 70);
    font-size: 12px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ── CURRENCY DISPLAY in header ── */

.elevator-currency {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    padding: 8px 16px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(255, 185, 0, 0.3);
}

.elevator-currency__icon {
    width: 22px;
    height: 22px;
    background-color: rgb(255, 200, 0);
    border-radius: 11px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgb(200, 140, 0);
}

.elevator-currency__value {
    color: rgb(255, 220, 120);
    font-size: 20px;
    -unity-font-style: bold;
    text-shadow: 0 0 6px rgba(255, 185, 0, 0.4);
}

/* ── DIVIDER — Rusted seam ── */

.elevator-divider {
    height: 2px;
    background-color: rgb(60, 45, 30);
    margin: 0;
    opacity: 0.7;
}

/* ── FLOORS CONTAINER ── */

.floors-container {
    flex-grow: 1;
    flex-direction: column;
    padding: 20px 24px;
    overflow: hidden;
}

/* ── FLOOR BUTTON — Mechanical lift selector ── */

.floor-button {
    height: 90px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding: 0;
    background-color: rgb(30, 25, 20);
    border-radius: 2px;
    border-width: 2px;
    border-color: rgb(55, 45, 35);
    transition-property: background-color, border-color, scale, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.floor-button:hover {
    background-color: rgb(42, 34, 26);
    border-color: rgb(200, 150, 50);
    scale: 1.015;
    translate: 4px 0;
}

.floor-button:active {
    scale: 0.98;
    background-color: rgb(50, 40, 30);
}

.floor-button:disabled {
    opacity: 1;
}

/* ── FLOOR STATES ── */

.floor-button--current {
    background-color: rgb(18, 12, 10);
    border-width: 2px;
    border-left-width: 5px;
    border-color: rgb(255, 50, 80);
    border-left-color: rgb(255, 50, 80);
}

.floor-button--current:hover {
    scale: 1;
    translate: 0 0;
    background-color: rgb(18, 12, 10);
    border-color: rgb(255, 50, 80);
}

.floor-button--travel {
    border-left-width: 4px;
    border-left-color: rgb(80, 180, 80);
}

.floor-button--travel:hover {
    border-color: rgb(100, 220, 100);
    border-left-color: rgb(100, 220, 100);
}

.floor-button--purchase {
    border-left-width: 4px;
    border-left-color: rgb(200, 150, 50);
}

.floor-button--purchase:hover {
    border-color: rgb(255, 200, 80);
    border-left-color: rgb(255, 200, 80);
}

.floor-button--cannot-afford {
    opacity: 0.5;
    border-left-width: 4px;
    border-left-color: rgb(100, 60, 30);
}

.floor-button--locked {
    background-color: rgb(16, 12, 10);
    opacity: 0.4;
    border-left-width: 4px;
    border-left-color: rgb(60, 40, 40);
}

/* ── NUMBER BOX — Industrial floor indicator ── */

.floor-button__number-box {
    width: 90px;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    border-right-width: 2px;
    border-right-color: rgb(50, 40, 30);
}

.floor-button__number-box Label {
    color: rgb(140, 130, 110);
    font-size: 38px;
    -unity-font-style: bold;
    transition-property: color, scale;
    transition-duration: 0.2s;
}

.floor-button:hover .floor-button__number-box Label {
    color: rgb(255, 210, 100);
    scale: 1.1;
}

.floor-button--current .floor-button__number-box Label {
    color: rgb(255, 50, 80);
    text-shadow: 0 0 12px rgba(255, 50, 80, 0.6);
}

.floor-button--purchase .floor-button__number-box Label {
    color: rgb(200, 150, 50);
}

.floor-button--travel .floor-button__number-box Label {
    color: rgb(80, 180, 80);
}

/* ── CONTENT — Floor info ── */

.floor-button__content {
    flex-grow: 1;
    justify-content: center;
    padding: 0 20px;
}

.floor-button__name {
    color: rgb(210, 190, 160);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    transition-property: color;
    transition-duration: 0.2s;
}

.floor-button:hover .floor-button__name {
    color: rgb(255, 240, 200);
}

.floor-button--current .floor-button__name {
    color: white;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.3);
}

.floor-button__description {
    color: rgb(110, 95, 75);
    font-size: 13px;
    margin-top: 4px;
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: 0.2s;
}

.floor-button:hover .floor-button__description {
    color: rgb(160, 140, 110);
}

/* ── ACTION TEXT — Right side status ── */

.floor-button__action-text {
    width: 140px;
    color: rgb(130, 120, 100);
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.4);
    height: 100%;
    border-left-width: 2px;
    border-left-color: rgb(50, 40, 30);
    transition-property: color, background-color;
    transition-duration: 0.2s;
}

.floor-button:hover .floor-button__action-text {
    background-color: rgba(0, 0, 0, 0.6);
}

.floor-button--current .floor-button__action-text {
    color: rgb(255, 50, 80);
    text-shadow: 0 0 6px rgba(255, 50, 80, 0.4);
}

.floor-button--travel .floor-button__action-text {
    color: rgb(80, 200, 80);
}

.floor-button--travel:hover .floor-button__action-text {
    color: rgb(120, 255, 120);
    text-shadow: 0 0 8px rgba(80, 200, 80, 0.5);
}

.floor-button--purchase .floor-button__action-text {
    color: rgb(220, 160, 50);
}

.floor-button--purchase:hover .floor-button__action-text {
    color: rgb(255, 200, 80);
    text-shadow: 0 0 8px rgba(255, 200, 80, 0.5);
}

.floor-button--cannot-afford .floor-button__action-text {
    color: rgb(140, 50, 40);
}

.floor-button--locked .floor-button__action-text {
    color: rgb(80, 50, 50);
    letter-spacing: 4px;
}

/* ── FOOTER — Exit controls ── */

.elevator-footer {
    justify-content: center;
    align-items: center;
    padding: 18px 24px;
    background-color: rgba(0, 0, 0, 0.3);
    border-top-width: 1px;
    border-top-color: rgb(50, 40, 30);
}

.close-button {
    width: 200px;
    height: 50px;
    background-color: rgb(35, 18, 18);
    color: rgb(200, 80, 70);
    font-size: 15px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgb(140, 45, 40);
    border-radius: 2px;
    transition-property: background-color, color, border-color, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.close-button:hover {
    background-color: rgb(160, 40, 40);
    color: rgb(255, 220, 210);
    border-color: rgb(200, 60, 50);
    scale: 1.03;
}

.close-button:active {
    scale: 0.97;
    background-color: rgb(120, 30, 30);
}
