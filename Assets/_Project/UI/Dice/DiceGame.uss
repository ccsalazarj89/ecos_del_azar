.dice-hud {
    position: absolute;
    bottom: 24px;
    left: 50%;
    translate: -50% 0;
    width: 340px;
    background-color: rgba(15, 15, 20, 0.92);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 200, 50, 0.4);
    padding: 20px;
    align-items: center;
}

.results-row {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-bottom: 16px;
}

.result-slot {
    align-items: center;
}

.result-slot__label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 6px;
}

.result-slot__value {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    min-width: 50px;
    min-height: 50px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.winner-label {
    font-size: 20px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.roll-btn {
    width: 160px;
    height: 44px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(40, 120, 50);
    border-color: rgb(60, 160, 70);
    border-width: 2px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
}

.roll-btn:hover {
    background-color: rgb(50, 140, 60);
    scale: 1.04;
}

.roll-btn:disabled {
    background-color: rgb(50, 50, 50);
    border-color: rgb(80, 80, 80);
    color: rgba(255, 255, 255, 0.4);
}
