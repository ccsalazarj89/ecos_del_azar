# ================================
# Unity .gitignore
# ================================

# Carpetas de recovery automático de Unity
Assets/_Recovery/
Assets/_Recovery.meta

# Carpetas generadas por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Carpetas generadas por VisualStudio/Rider
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos de metadatos de Unity (sólo los de carpetas ignoradas)
# Los .meta de Assets SÍ deben subirse
[Ll]ibrary/**
[Tt]emp/**

# Cache de asset imports
[Aa]sset[Ss]tore-5.x/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Archivos de sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Node (por si usas herramientas JS auxiliares)
node_modules/
npm-debug.log*

# TextMesh Pro (generado automáticamente por Unity)
Assets/TextMesh Pro/
Assets/TextMesh Pro.meta
